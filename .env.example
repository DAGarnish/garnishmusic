# Copy to .env and fill in real values. Never commit .env itself.

# --- Payload / database ---
PAYLOAD_SECRET=
# Local dev: postgresql://garnishmusic:garnishmusic@localhost:5432/garnishmusic
# (matches docker-compose.yml - run `docker compose up -d` first)
# Production: the real Neon connection string - keep this out of anywhere
# that gets shared or committed.
POSTGRES_URI=

# --- Media storage (S3) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Stripe (checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Content bot ---
# Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# A random string you choose yourself - pass it as the `secret_token` param
# when calling Telegram's setWebhook, and the bot checks every incoming
# request's X-Telegram-Bot-Api-Secret-Token header against this value.
TELEGRAM_WEBHOOK_SECRET=
# From console.anthropic.com - used to interpret admin messages via tool use.
ANTHROPIC_API_KEY=
# Set to "true" to skip the real Claude call entirely and use a canned
# response instead - for testing the rest of the bot (buttons, permissions,
# audit log) with zero API cost and no key at all. Never set this in
# production - leave unset so a missing ANTHROPIC_API_KEY fails loudly
# instead of silently faking responses.
BOT_MOCK_MODE=
# Only used by the mock above - which page slug to propose changes against.
BOT_MOCK_PAGE_SLUG=
